[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Mfg%
CatalogFile=NvRmDrv.cat
DriverVer=11/13/2026,1.0.0.0

[Manufacturer]
%Mfg%=NvRmDrv,NTamd64

[NvRmDrv.NTamd64]
%DevDesc%=NvRmDrv_Inst,ROOT\NvRmDrv

[NvRmDrv_Inst]
CopyFiles=@NvRmDrv.sys

[NvRmDrv_Inst.Services]
AddService=NvRmDrv,0x00000002,NvRmDrv_Service

[NvRmDrv_Service]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\NvRmDrv.sys

[DestinationDirs]
DefaultDestDir=12

[Strings]
Mfg="NVIDIA Corporation"
DevDesc="NVIDIA Kernel Mode Driver"
